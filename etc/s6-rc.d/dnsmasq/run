#!/command/with-contenv ash

# Wait until NGINX is running
until getent hosts nginx; do echo 'Checking NGINX'; sleep 0.5; done

# Point all .test domains to NGINX container
if ! grep -q address=/.test/$(getent hosts nginx | awk '{print $1}') "/etc/dnsmasq.conf"; then
    echo -e '\n# Point all .test domains to NGINX container\naddress=/.test/'$(getent hosts nginx | awk '{print $1}') >> /etc/dnsmasq.conf
fi

# Start DNSMasq
dnsmasq -k $COMMANDS

